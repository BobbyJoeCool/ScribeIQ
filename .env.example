# Copy to .env and fill in. .env is gitignored.

# Free Hugging Face read token. Only needed to tell apart multiple speakers
# (group calls, or audio files with speaker labels). See README.
HF_TOKEN=

# Optional: how you're labeled in call transcripts (default "Me").
# SCRIBEIQ_MY_NAME=Bob

# Optional: where recordings and transcripts are saved
# (default: Outputs/ in this project, which is gitignored).
# SCRIBEIQ_HOME=~/Documents/ScribeIQ/Output
